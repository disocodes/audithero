{"datasets":[{"name":"kpi","displayName":"Payroll KPI","queryLines":["SELECT COUNT(*) AS pay_periods,","SUM(CASE WHEN status='UNDERPAID' THEN 1 ELSE 0 END) AS underpaid_periods,","SUM(CASE WHEN status='OVERPAID' THEN 1 ELSE 0 END) AS overpaid_periods,","SUM(CASE WHEN status='REQUIRES_REVIEW' THEN 1 ELSE 0 END) AS review_periods,","ROUND(SUM(CASE WHEN status='UNDERPAID' THEN -variance_actual_minus_expected ELSE 0 END),2) AS potential_underpayment,","ROUND(SUM(CASE WHEN status='OVERPAID' THEN variance_actual_minus_expected ELSE 0 END),2) AS potential_overpayment","FROM v_reconciliation_latest"]},{"name":"monthly","displayName":"Monthly Status","queryLines":["SELECT date_trunc('MONTH',pay_period_end) AS month,status,COUNT(*) AS periods","FROM v_reconciliation_latest GROUP BY ALL ORDER BY month"]},{"name":"exceptions","displayName":"Exceptions","queryLines":["SELECT employee_name,pay_period_start,pay_period_end,expected_amount,actual_auditable_amount,variance_actual_minus_expected,status,unmapped_pay_categories","FROM v_reconciliation_latest WHERE status <> 'COMPLIANT'","ORDER BY CASE status WHEN 'UNDERPAID' THEN 1 WHEN 'REQUIRES_REVIEW' THEN 2 WHEN 'OVERPAID' THEN 3 ELSE 4 END,ABS(COALESCE(variance_actual_minus_expected,0)) DESC"]},{"name":"events","displayName":"Supplemental Entitlements","queryLines":["SELECT employee_name,event_type,pay_period_start,pay_period_end,expected_adjustment,event_status,review_flags","FROM v_event_adjustments_latest ORDER BY pay_period_start DESC"]},{"name":"detail","displayName":"Shift Evidence","queryLines":["SELECT employee_name,shift_start,shift_end,employment_type,classification_code,work_group,worked_hours,expected_amount,entitlement_status,review_flags","FROM v_audit_detail_latest ORDER BY shift_start DESC"]},{"name":"rules","displayName":"Rule Coverage","queryLines":["SELECT pack_type,classification_family,pack_id,operative_date,verification_status,source_url","FROM v_rule_coverage ORDER BY pack_type,classification_family,operative