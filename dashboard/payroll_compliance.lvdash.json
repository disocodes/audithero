{"datasets":[{"name":"kpi","displayName":"Payroll KPI","query":"SELECT COUNT(*) AS pay_periods, COALESCE(SUM(CASE WHEN status='UNDERPAID' THEN 1 ELSE 0 END),0) AS underpaid_periods, COALESCE(SUM(CASE WHEN status='OVERPAID' THEN 1 ELSE 0 END),0) AS overpaid_periods, COALESCE(SUM(CASE WHEN status='REQUIRES_REVIEW' THEN 1 ELSE 0 END),0) AS review_periods, COALESCE(SUM(CASE WHEN status IN ('ENTITLEMENT_ONLY','ACTUAL_PAY_UNAVAILABLE') THEN 1 ELSE 0 END),0) AS entitlement_only_periods, ROUND(COALESCE(SUM(CASE WHEN status='UNDERPAID' THEN -variance_actual_minus_expected ELSE 0 END),0),2) AS potential_underpayment, ROUND(COALESCE(SUM(CASE WHEN status='OVERPAID' THEN variance_actual_minus_expected ELSE 0 END),0),2) AS potential_overpayment, ROUND(COALESCE(SUM(expected_amount),0),2) AS expected_pay, ROUND(COALESCE(SUM(actual_auditable_amount),0),2) AS actual_pay FROM v_reconciliation_latest"},{"name":"status_summary","displayName":"Status Summary","query":"SELECT status, COUNT(*) AS pay_periods, ROUND(COALESCE(SUM(expected_amount),0),2) AS expected_pay, ROUND(COALESCE(SUM(actual_auditable_amount),0),2) AS actual_pay FROM v_reconciliation_latest GROUP BY status ORDER BY pay_periods DESC"},{"name":"exceptions","displayName":"Exceptions","query":"SELECT employee_name,pay_period_start,pay_period_end,expected_amount,actual_auditable_amount,variance_actual_minus_expected,status,unmapped_pay_categories,audit_run_id FROM v_reconciliation_latest WHERE status <> 'COMPLIANT' ORDER BY ABS(COALESCE(variance_actual_minus_expected,0)) DESC"},{"name":"detail","displayName":"Shift Evidence","query":"SELECT employee_name,shift_start,shift_end,employment_type,classification_code,work_group,state,worked_hours,base_hourly_rate,expected_amount,entitlement_status,review_flags,audit_run_id FROM v_audit_detail_latest ORDER BY shift_start DESC"},{"name":"supplemental","displayName":"Supplemental Entitlements","query":"SELECT employee_name,event_type,pay_period_start,pay_period_end,expected_adjustment,event_status,review_flags,audit_run_id FROM v_event_adjustments_latest ORDER BY run_finished_at DESC"},{"name":"toil","displayName":"TOIL Findings","query":"SELECT * FROM v_toil_findings_latest ORDER BY run_finished_at DESC"},{"name":"runs","displayName":"Audit Runs","query":"SELECT audit_run_id,run_type,audit_window_start,audit_window_end,started_at,finished_at,status,actual_pay_source,employees,timesheets,underpaid_periods,overpaid_periods,review_periods,message FROM v_audit_runs ORDER BY finished_at DESC"},{"name":"readiness","displayName":"Readiness","query":"SELECT finding_type,source_key,source_key AS source_label,status,detail,checked_at FROM v_readiness_findings ORDER BY checked_at DESC"},{"name":"rules","displayName":"Rule Coverage","query":"SELECT pack_type,pack_id,operative_date,verification_status,source_publisher,source_url FROM v_rule_coverage ORDER BY pack_type,operative_date"}],"pages":[{"name":"overview","displayName":"Payroll Overview","pageType":"PAGE_TYPE_CANVAS","layout":[{"widget":{"name":"overview_title","multilineTextboxSpec":{"lines":["<span style=\"font-size: 24px;\">AuditHero — SCHADS Payroll Compliance</span>"]}},"position":{"x":0,"y":0,"width":6,"height":1}},{"widget":{"name":"pay_periods","queries":[{"name":"main_query","query":{"datasetName":"kpi","fields":[{"name":"pay_periods","expression":"`pay_periods`"}],"disaggregated":true}}],"spec":{"version":2,"widgetType":"counter","encodings":{"value":{"fieldName":"pay_periods","format":{"type":"number-plain","abbreviation":"none","decimalPlaces":{"type":"max","places":0}},"displayName":"Audited Pay Periods"}},"frame":{"showTitle":true,"title":"Audited Pay Periods"}}},"position":{"x":0,"y":1,"width":2,"height":2}},{"widget":{"name":"underpaid","queries":[{"name":"main_query","query":{"datasetName":"kpi","fields":[{"name":"underpaid_periods","expression":"`underpaid_periods`"}],"disaggregated":true}}],"spec":{"version":2,"widgetType":"counter","encodings":{"value":{"fieldName":"underpaid_peri