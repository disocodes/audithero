{
  "datasets": [
    {
      "name": "kpi",
      "displayName": "Payroll KPI",
      "queryLines": [
        "SELECT COUNT(*) AS pay_periods,",
        "SUM(CASE WHEN status='UNDERPAID' THEN 1 ELSE 0 END) AS underpaid_periods,",
        "SUM(CASE WHEN status='OVERPAID' THEN 1 ELSE 0 END) AS overpaid_periods,",
        "SUM(CASE WHEN status='REQUIRES_REVIEW' THEN 1 ELSE 0 END) AS review_periods,",
        "ROUND(SUM(CASE WHEN status='UNDERPAID' THEN -variance_actual_minus_expected ELSE 0 END),2) AS potential_underpayment,",
        "ROUND(SUM(CASE WHEN status='OVERPAID' THEN variance_actual_minus_expected ELSE 0 END),2) AS potential_overpayment",
        "FROM v_reconciliation_latest"
      ]
    },
    {
      "name": "exceptions",
      "displayName": "Exceptions",
      "queryLines": [
        "SELECT employee_name,pay_period_start,pay_period_end,expected_amount,actual_auditable_amount,variance_actual_minus_expected,status,unmapped_pay_categories,audit_run_id",
        "FROM v_reconciliation_latest WHERE status <> 'COMPLIANT'",
        "ORDER BY CASE status WHEN 'UNDERPAID' THEN 1 WHEN 'REQUIRES_REVIEW' THEN 2 WHEN 'OVERPAID' THEN 3 ELSE 4 END,ABS(COALESCE(variance_actual_minus_expected,0)) DESC"
      ]
    },
    {
      "name": "detail",
      "displayName": "Shift Evidence",
      "queryLines": [
        "SELECT employee_name,shift_start,shift_end,employment_type,classification_code,work_group,state,holiday_location_key,worked_hours,sleepover_span_hours,base_hourly_rate,expected_amount,entitlement_status,review_flags,calculation_evidence,audit_run_id",
        "FROM v_audit_detail_latest ORDER BY shift_start DESC"
      ]
    },
    {
      "name": "supplemental",
      "displayName": "Supplemental Entitlements",
      "queryLines": [
        "SELECT employee_name,event_type,pay_period_start,pay_period_end,expected_adjustment,event_status,review_flags,calculation_evidence,audit_run_id",
        "FROM audit_event_adjustments ORDER BY run_finished_at DESC"
      ]
    },
    {
      "name": "toil",
      "displayName": "TOIL Findings",
      "queryLines": [
        "SELECT * FROM toil_findings ORDER BY run_finished_at DESC"
      ]
    },
    {
      "name": "runs",
      "displayName": "Audit Runs",
      "queryLines": [
        "SELECT audit_run_id,run_type,audit_window_start,audit_window_end,started_at,finished_at,status,actual_pay_source,employees,timesheets,underpaid_periods,overpaid_periods,review_periods,message",
        "FROM audit_runs ORDER BY finished_at DESC"
      ]
    },
    {
      "name": "rules",
      "displayName": "Rule Coverage",
      "queryLines": [
        "SELECT pack_type,pack_id,operative_date,verification_status,source_publisher,source_url FROM rule_coverage ORDER BY pack_type,operative_date"
      ]
    }
  ],
  "pages": [
    {"name":"overview","displayName":"Payroll Overview","pageType":"PAGE_TYPE_CANVAS","layout":[{"widget":{"name":"title","multilineTextboxSpec":{"lines":["<span style=\"font-size: 24px;\">AuditHero — Complete SCHADS Payroll Compliance</span>"]}},"position":{"x":0,"y":0,"width":6,"height":1}}]},
    {"name":"exceptions","displayName":"Exceptions","pageType":"PAGE_TYPE_CANVAS","layout":[{"widget":{"name":"title","multilineTextboxSpec":{"lines":["<span style=\"font-size: 24px;\">Underpayment / Overpayment / Review Queue</span>"]}},"position":{"x":0,"y":0,"width":6,"height":1}}]},
    {"name":"evidence","displayName":"Shift Evidence","pageType":"PAGE_TYPE_CANVAS","layout":[{"widget":{"name":"title","multilineTextboxSpec":{"lines":["<span style=\"font-size: 24px;\">Shift Calculation Evidence</span>"]}},"position":{"x":0,"y":0,"width":6,"height":1}}]},
    {"name":"supplemental","displayName":"Supplemental & TOIL","pageType":"PAGE_TYPE_CANVAS","layout":[{"widget":{"name":"title","multilineTextboxSpec":{"lines":["<span style=\"font-size: 24px;\">Supplemental Entitlements and TOIL</span>"]}},"position":{"x":0,"y":0,"width":6,"height":1}}]},
    {"name":"controls","displayName":"Runs & Rules","pageType":"PAGE_TYPE_CANVAS","layout":[{"widget":{"name":"title","multilineTextboxSpec":{"lines":["<span style=\"font-size: 24px;\">Audit Runs and Effective-Dated Rule Coverage</span>"]}},"position":{"x":0,"y":0,"width":6,"height":1}}]}
  ]
}
