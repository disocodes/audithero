{
  "datasets": [
    {
      "name": "investigation",
      "display_name": "Audit Investigation",
      "query": "SELECT * FROM v_audit_investigation_latest"
    },
    {
      "name": "rest",
      "display_name": "Rest Between Work",
      "query": "SELECT finding_id,finding_type,employee_id,employee_name,previous_timesheet_ids,next_timesheet_ids,previous_shift_end,next_shift_start,required_rest_hours,actual_rest_hours,rest_shortfall_hours,sleepover_adjacent_exception_eligible,sleepover_8h_agreement,sleepover_blocked_rest,historical_sleepover_interaction,overtime_rest_rule_applies,employer_instructed_resume,release_datetime,double_time_repriced_hours,double_time_topup,paid_absence_rostered_hours,payment_status,status,clause,overtime_clause,evidence_reference,notes,audit_run_id,run_type FROM v_rest_break_findings_latest ORDER BY next_shift_start DESC"
    },
    {
      "name": "runs",
      "display_name": "Audit Runs",
      "query": "SELECT audit_run_id,run_type,audit_window_start,audit_window_end,finished_at,status,actual_pay_source,employees,timesheets,underpaid_periods,overpaid_periods,review_periods,message FROM v_audit_runs ORDER BY finished_at DESC"
    },
    {
      "name": "readiness",
      "display_name": "Readiness",
      "query": "SELECT finding_type,source_key,status,detail,checked_at FROM v_readiness_findings ORDER BY checked_at DESC"
    },
    {
      "name": "rules",
      "display_name": "Rule Coverage",
      "query": "SELECT pack_type,pack_id,operative_date,verification_status,source_publisher,source_url FROM v_rule_coverage ORDER BY pack_type,operative_date"
    }
  ],
  "pages": [
    {
      "name": "global_filters",
      "display_name": "Global Filters",
      "page_type": "PAGE_TYPE_GLOBAL_FILTERS",
      "widgets": [
        {"type":"filter","name":"date_filter","dataset":"investigation","field":"pay_period_start","title":"Pay Period","filter_type":"date-range","position":[0,0,2,1]},
        {"type":"filter","name":"status_filter","dataset":"investigation","field":"reconciliation_status","title":"Audit Status","selection":"multi","position":[2,0,2,1]},
        {"type":"filter","name":"employee_filter","dataset":"investigation","field":"employee_name","title":"Employee","selection":"multi","position":[4,0,2,1]},
        {"type":"filter","name":"employment_filter","dataset":"investigation","field":"employment_type","title":"Employment Type","selection":"multi","position":[0,1,2,1]},
        {"type":"filter","name":"classification_filter","dataset":"investigation","field":"classification_code","title":"Classification","selection":"multi","position":[2,1,2,1]},
        {"type":"filter","name":"work_group_filter","dataset":"investigation","field":"work_group","title":"Work Group","selection":"multi","position":[4,1,1,1]},
        {"type":"filter","name":"state_filter","dataset":"investigation","field":"state","title":"State","selection":"multi","position":[5,1,1,1]}
      ]
    },
    {
      "name": "overview",
      "display_name": "Interactive Overview",
      "widgets": [
        {"type":"text","name":"overview_title","text":"## AuditHero — SCHADS Payroll Compliance\nCross-filter a chart or right-click a pay-period result to drill into the underlying shift evidence.","position":[0,0,6,1]},
        {"type":"counter","name":"period_count","dataset":"investigation","title":"Audited Pay Periods","expression":"SUM(`pay_period_marker`)","decimals":0,"position":[0,1,1,2]},
        {"type":"counter","name":"employee_count","dataset":"investigation","title":"Employees","expression":"COUNT(DISTINCT `employee_id`)","decimals":0,"position":[1,1,1,2]},
        {"type":"counter","name":"review_shift_count","dataset":"investigation","title":"Review Shifts","expression":"SUM(`review_shift_marker`)","decimals":0,"position":[2,1,1,2]},
        {"type":"counter","name":"expected_pay","dataset":"investigation","title":"Expected Pay","expression":"SUM(`period_expected_amount_once`)","format":"currency","decimals":2,"position":[3,1,1,2]},
        {"type":"counter","name":"potential_underpayment","dataset":"investigation","title":"Potential Underpayment","expression":"SUM(`underpayment_amount_once`)","format":"currency","decimals":2,"position":[4,1,1,2]},
        {"type":"counter","name":"potential_overpayment","dataset":"investigation","title":"Potential Overpayment","expression":"SUM(`overpayment_amount_once`)","format":"currency","decimals":2,"position":[5,1,1,2]},
        {"type":"bar","name":"status_chart","dataset":"investigation","title":"Pay Periods by Audit Status","x":"reconciliation_status","x_title":"Audit Status","y_expression":"SUM(`pay_period_marker`)","y_name":"pay_periods","y_title":"Pay Periods","color":"reconciliation_status","position":[0,3,3,6]},
        {"type":"bar","name":"underpayment_employee_chart","dataset":"investigation","title":"Potential Underpayment by Employee","x":"employee_name","x_title":"Employee","y_expression":"SUM(`underpayment_amount_once`)","y_name":"underpayment","y_title":"Underpayment","format":"currency","decimals":2,"orientation":"horizontal","position":[3,3,3,6]},
        {"type":"line","name":"variance_trend","dataset":"investigation","title":"Variance Trend by Pay Period","x":"pay_period_start","x_title":"Pay Period","x_scale":"temporal","y_expression":"SUM(`variance_amount_once`)","y_name":"variance","y_title":"Variance","format":"currency","decimals":2,"position":[0,9,3,6]},
        {"type":"bar","name":"review_classification_chart","dataset":"investigation","title":"Review Shifts by Classification","x":"classification_code","x_title":"Classification","y_expression":"SUM(`review_shift_marker`)","y_name":"review_shifts","y_title":"Review Shifts","orientation":"horizontal","position":[3,9,3,6]},
        {
          "type":"table","name":"period_summary","dataset":"investigation","title":"Pay Period Investigation Summary","description":"Right-click a result and choose Drill to → Employee / Pay Period Investigation.","disaggregated":false,"position":[0,15,6,10],
          "columns":[
            {"field":"employee_pay_period","title":"Employee / Pay Period"},
            {"field":"employee_name","title":"Employee"},
            {"field":"pay_period_start","title":"Period Start"},
            {"field":"pay_period_end","title":"Period End"},
            {"field":"reconciliation_status","title":"Audit Status"},
            {"field":"pay_period_expected_amount","title":"Expected","kind":"number","number_format":"$0,0.00"},
            {"field":"actual_auditable_amount","title":"Actual Auditable","kind":"number","number_format":"$0,0.00"},
            {"field":"variance_actual_minus_expected","title":"Variance","kind":"number","number_format":"$0,0.00"},
            {"field":"unmapped_pay_categories","title":"Unmapped Pay Categories"}
          ]
        }
      ]
    },
    {
      "name": "investigation",
      "display_name": "Employee / Pay Period Investigation",
      "widgets": [
        {"type":"text","name":"investigation_title","text":"## Employee / Pay Period Investigation\nUse drill-through from Overview or select a specific employee/pay period below.","position":[0,0,6,1]},
        {"type":"filter","name":"pay_period_filter","dataset":"investigation","field":"employee_pay_period","title":"Employee + Pay Period","selection":"single","position":[0,1,3,1]},
        {"type":"filter","name":"entitlement_status_filter","dataset":"investigation","field":"entitlement_status","title":"Shift Status","selection":"multi","position":[3,1,1,1]},
        {"type":"filter","name":"weekday_filter","dataset":"investigation","field":"weekday_name","title":"Weekday","selection":"multi","position":[4,1,1,1]},
        {"type":"filter","name":"run_type_filter","dataset":"investigation","field":"run_type","title":"Run Type","selection":"multi","position":[5,1,1,1]},
        {"type":"counter","name":"investigation_shifts","dataset":"investigation","title":"Shifts","expression":"COUNT(`timesheet_id`)","decimals":0,"position":[0,2,1,2]},
        {"type":"counter","name":"investigation_hours","dataset":"investigation","title":"Worked Hours","expression":"SUM(`worked_hours`)","decimals":2,"position":[1,2,1,2]},
        {"type":"counter","name":"investigation_shift_expected","dataset":"investigation","title":"Shift Expected","expression":"SUM(`shift_expected_amount`)","format":"currency","decimals":2,"position":[2,2,1,2]},
        {"type":"counter","name":"investigation_period_expected","dataset":"investigation","title":"Period Expected","expression":"SUM(`period_expected_amount_once`)","format":"currency","decimals":2,"position":[3,2,1,2]},
        {"type":"counter","name":"investigation_actual","dataset":"investigation","title":"Actual Auditable","expression":"SUM(`actual_auditable_amount_once`)","format":"currency","decimals":2,"position":[4,2,1,2]},
        {"type":"counter","name":"investigation_variance","dataset":"investigation","title":"Variance","expression":"SUM(`variance_amount_once`)","format":"currency","decimals":2,"position":[5,2,1,2]},
        {"type":"bar","name":"weekday_hours_chart","dataset":"investigation","title":"Worked Hours by Weekday","x":"weekday_name","x_title":"Weekday","y_expression":"SUM(`worked_hours`)","y_name":"worked_hours_total","y_title":"Hours","position":[0,4,3,6]},
        {"type":"bar","name":"status_expected_chart","dataset":"investigation","title":"Expected Entitlement by Shift Status","x":"entitlement_status","x_title":"Shift Status","y_expression":"SUM(`shift_expected_amount`)","y_name":"expected_total","y_title":"Expected","format":"currency","decimals":2,"color":"entitlement_status","position":[3,4,3,6]},
        {
          "type":"table","name":"shift_detail","dataset":"investigation","title":"Underlying Shift Evidence","position":[0,10,6,11],
          "columns":[
            {"field":"timesheet_id","title":"Timesheet ID"},
            {"field":"shift_start","title":"Shift Start"},
            {"field":"shift_end","title":"Shift End"},
            {"field":"worked_hours","title":"Hours","kind":"number","number_format":"0.00"},
            {"field":"employment_type","title":"Employment Type"},
            {"field":"classification_code","title":"Classification"},
            {"field":"work_group","title":"Work Group"},
            {"field":"base_hourly_rate","title":"Base Rate","kind":"number","number_format":"$0.00"},
            {"field":"shift_expected_amount","title":"Expected","kind":"number","number_format":"$0,0.00"},
            {"field":"entitlement_status","title":"Entitlement Status"},
            {"field":"review_flags","title":"Review Flags"}
          ]
        },
        {
          "type":"table","name":"calculation_evidence","dataset":"investigation","title":"Calculation and Instrument Evidence","description":"Expand Calculation Evidence to inspect the components used by the deterministic audit engine.","position":[0,21,6,11],
          "columns":[
            {"field":"timesheet_id","title":"Timesheet ID"},
            {"field":"award_reference_date","title":"Award Reference Date"},
            {"field":"industrial_instrument_type","title":"Instrument Type"},
            {"field":"industrial_instrument_name","title":"Instrument"},
            {"field":"instrument_reference","title":"Instrument Reference"},
            {"field":"part_time_pattern_status","title":"Part-time Pattern Status"},
            {"field":"review_flags","title":"Review Flags"},
            {"field":"calculation_evidence","title":"Calculation Evidence","kind":"json"}
          ]
        }
      ]
    },
    {
      "name": "rest_breaks",
      "display_name": "Rest & Breaks",
      "widgets": [
        {"type":"text","name":"rest_title","text":"## Rest Between Work\nReview effective-dated 10-hour and agreed 8-hour rest requirements and evidence-backed rest-after-overtime payment consequences.","position":[0,0,6,1]},
        {"type":"filter","name":"rest_employee_filter","dataset":"rest","field":"employee_name","title":"Employee","selection":"multi","position":[0,1,2,1]},
        {"type":"filter","name":"rest_status_filter","dataset":"rest","field":"status","title":"Finding Status","selection":"multi","position":[2,1,1,1]},
        {"type":"filter","name":"rest_payment_filter","dataset":"rest","field":"payment_status","title":"Payment Status","selection":"multi","position":[3,1,1,1]},
        {"type":"filter","name":"rest_overtime_filter","dataset":"rest","field":"overtime_rest_rule_applies","title":"Overtime Rest Rule","selection":"multi","position":[4,1,1,1]},
        {"type":"filter","name":"rest_run_filter","dataset":"rest","field":"run_type","title":"Run Type","selection":"multi","position":[5,1,1,1]},
        {"type":"counter","name":"rest_intervals","dataset":"rest","title":"Intervals Assessed","expression":"COUNT(`finding_id`)","decimals":0,"position":[0,2,1,2]},
        {"type":"counter","name":"short_rest_intervals","dataset":"rest","title":"Short Rest","expression":"SUM(CASE WHEN `rest_shortfall_hours` > 0 THEN 1 ELSE 0 END)","decimals":0,"position":[1,2,1,2]},
        {"type":"counter","name":"rest_reviews","dataset":"rest","title":"Requires Review","expression":"SUM(CASE WHEN `status` = 'REQUIRES_REVIEW' THEN 1 ELSE 0 END)","decimals":0,"position":[2,2,1,2]},
        {"type":"counter","name":"rest_overtime_cases","dataset":"rest","title":"Overtime Rest Cases","expression":"SUM(CASE WHEN `overtime_rest_rule_applies` THEN 1 ELSE 0 END)","decimals":0,"position":[3,2,1,2]},
        {"type":"counter","name":"rest_repriced_hours","dataset":"rest","title":"Repriced Hours","expression":"SUM(`double_time_repriced_hours`)","decimals":2,"position":[4,2,1,2]},
        {"type":"counter","name":"rest_topup","dataset":"rest","title":"Double-Time Top-up","expression":"SUM(`double_time_topup`)","format":"currency","decimals":2,"position":[5,2,1,2]},
        {"type":"bar","name":"rest_status_chart","dataset":"rest","title":"Rest Intervals by Status","x":"status","x_title":"Status","y_expression":"COUNT(`finding_id`)","y_name":"intervals","y_title":"Intervals","color":"status","position":[0,4,3,6]},
        {"type":"bar","name":"rest_employee_shortfall","dataset":"rest","title":"Rest Shortfall Hours by Employee","x":"employee_name","x_title":"Employee","y_expression":"SUM(`rest_shortfall_hours`)","y_name":"shortfall_hours","y_title":"Shortfall Hours","orientation":"horizontal","position":[3,4,3,6]},
        {
          "type":"table","name":"rest_findings_table","dataset":"rest","title":"Rest Between Work Findings","description":"General short-rest findings are compliance findings. A monetary top-up is shown only where the applicable payment rule and supporting evidence allow AuditHero to calculate it.","position":[0,10,6,13],
