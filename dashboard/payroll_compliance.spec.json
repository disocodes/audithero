{
  "datasets": [
    {"name":"investigation","display_name":"Definitive Audit Investigation","query":"SELECT * FROM v_audit_investigation_latest"},
    {"name":"scenario","display_name":"SCHADS Award Scenarios","query":"SELECT * FROM v_award_scenario_detail_latest"},
    {"name":"criteria","display_name":"SCHADS Award Criteria","query":"SELECT * FROM v_award_criteria_detail_latest"},
    {"name":"penalties","display_name":"Penalties and Shiftwork","query":"SELECT * FROM v_award_criteria_detail_latest WHERE criterion_group IN ('PENALTIES_AND_SHIFTWORK','PUBLIC_HOLIDAYS','MINIMUM_ENGAGEMENT')"},
    {"name":"overtime","display_name":"Overtime Criteria","query":"SELECT * FROM v_award_criteria_detail_latest WHERE criterion_group='OVERTIME'"},
    {"name":"meal_breaks","display_name":"Meal Break Criteria","query":"SELECT * FROM v_award_criteria_detail_latest WHERE criterion_group='MEAL_BREAKS'"},
    {"name":"sleep_broken","display_name":"Sleepover Broken Shift and Minimum Engagement","query":"SELECT * FROM v_award_criteria_detail_latest WHERE criterion_group IN ('SLEEPOVER','BROKEN_SHIFT','MINIMUM_ENGAGEMENT','ALLOWANCES')"},
    {"name":"evidence","display_name":"Evidence Required","query":"SELECT * FROM v_award_criteria_detail_latest WHERE criterion='EVIDENCE_OR_RULE_REVIEW'"},
    {"name":"scenario_rest","display_name":"Scenario Rest Between Work","query":"SELECT * FROM v_award_scenario_rest_findings_latest ORDER BY next_shift_start DESC"},
    {"name":"reconciliation","display_name":"Definitive Actual versus Expected","query":"SELECT * FROM v_reconciliation_latest"},
    {"name":"runs","display_name":"Audit Runs","query":"SELECT audit_run_id,run_type,audit_window_start,audit_window_end,finished_at,status,actual_pay_source,employees,timesheets,underpaid_periods,overpaid_periods,review_periods,message FROM v_audit_runs ORDER BY finished_at DESC"},
    {"name":"readiness","display_name":"Readiness","query":"SELECT finding_type,source_key,status,detail,checked_at FROM v_readiness_findings ORDER BY checked_at DESC"},
    {"name":"rules","display_name":"Rule Coverage","query":"SELECT pack_type,pack_id,operative_date,verification_status,source_publisher,source_url FROM v_rule_coverage ORDER BY pack_type,operative_date"}
  ],
  "pages": [
