            {"field":"overtime_rest_rule_applies","title":"Overtime Rest Rule","kind":"boolean"},
            {"field":"employer_instructed_resume","title":"Employer Instructed Resume","kind":"boolean"},
            {"field":"release_datetime","title":"Release Time"},
            {"field":"double_time_repriced_hours","title":"Repriced Hours","kind":"number","number_format":"0.00"},
            {"field":"double_time_topup","title":"Double-Time Top-up","kind":"number","number_format":"$0,0.00"},
            {"field":"paid_absence_rostered_hours","title":"Rostered Hours in Paid Absence Window","kind":"number","number_format":"0.00"},
